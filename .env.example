# Copy to .env and fill in your keys
GOOGLE_API_KEY=

# Langfuse tracing (the class's shared Langfuse: keys and URL are on the class dashboard)
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_BASE_URL=
# Your name in Langfuse's Users view for traces from the CLI
ACME_STUDENT=

# Which Gemma model to use
ACME_MODEL=gemma-4-26b-a4b-it

# ACME Systems API: the URL your instructor gives you
ACME_API_URL=https://acme-api-production-5b8f.up.railway.app
